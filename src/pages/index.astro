---
import ASCIIText from "@/components/ASCIIText";
import TextReveal from "@/components/TextReveal.astro";
import "./styles/global.css";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <title>Takyon</title>

    <!-- for fonts -->
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Noto+Sans:wght@100..900&display=swap"
    />
  </head>

  <style is:global>
    html, body {
      background: #11111b;
      user-select: none;
      -webkit-user-select: none;
    }

    body {
      --hero-height: clamp(9rem, 34vw, 18rem);
    }

    .profile {
      position: relative;
      z-index: 10;
      width: 100%;
      max-width: 48rem;
      margin-inline: auto;
      padding: var(--hero-height) 1rem clamp(3rem, 12.5vw, 6.5rem);
      text-align: center;
      font-family: "Noto Sans", sans-serif;
      font-size: clamp(0.75rem, 3.2vw, 1rem);
      font-weight: 800;
      line-height: 1.5;
    }

    .profile .section-title {
      margin-top: 0.5rem;
      font-size: clamp(2.25rem, 8.13vw, 3.75rem);
      font-weight: 400;
      line-height: 1;
    }

    .profile .first-title {
      margin-top: 0;
    }

    .contact-links, .credit {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: center;
      gap: 0.75rem;
    }

    .credit {
      margin-top: clamp(4rem, 12.5vw, 6.5rem);
      font-weight: 500;
    }

    @media (max-width: 40rem) {
      .page {
        display: grid;
        align-items: center;
      }
    }

    .chuj-font {
      font-family: "Instrument Serif", serif !important;
      font-style: normal !important;
    }

    a.hover-box {
      color: white;
      display: inline-block;
      padding: 2px 2px;
      text-decoration: none;
      transition: background-color 0.2s ease, color 0.2s ease;
    }

    a.hover-box:hover {
      background-color: white;
      color: #11111b;
    }
  </style>

  <body class="min-h-screen bg-[#11111b] text-white">
    <div class="page relative min-h-svh w-full">
      <ASCIIText
        client:load
        text="Haii~"
        textAreaHeight="var(--hero-height)"
        textAreaAnchorId="profile"
        asciiFontSize={8}
        colors={["#a855f7", "#ffffff", "#ffd866"]}
        textScale={1.1}
        blocks={0.9}
        waves={1}
        waveSpeed={1}
        chroma={3}
        tilt={1}
        hueShift={2}
        scramble={0.6}
        clickRipple={true}
        idle={true}
        interactive={true}
        charset={" .'`^\",:;Il!i~+_-?][}{1)(|/tfjrxnuvczXYUJCLQ0OZmwqpdbkhao*#MW&8%B@$"}
      />

      <main id="profile" class="profile">
        <TextReveal delay={100} duration={1000}>
          <h1 class="section-title first-title chuj-font">
            who am i?
          </h1>
        </TextReveal>

        <TextReveal delay={250} duration={1100}>
          <p>
            takyon303 / eden takyon — 20, logistics student
          </p>
        </TextReveal>

        <TextReveal delay={100} duration={1000}>
          <h2 class="section-title chuj-font">
            interests
          </h2>
        </TextReveal>

        <TextReveal delay={200} duration={1000}>
          <p>
            music — production & listening<br>
            tech — linux, android, hardware<br>
            coding — getting into it
          </p>
        </TextReveal>

        <TextReveal delay={100} duration={1000}>
          <h2 class="section-title chuj-font">
            coding
          </h2>
        </TextReveal>

        <TextReveal delay={200} duration={1000}>
          <h1
            class="translate-y-10 text-center mt-20"
            style="font-family: 'Noto Sans', sans-serif; font-style: normal; font-weight: 800;"
          >
          <p>
            chatgpt and claude are walking me through it,<br> as sad as it sounds <br>
            someday i’ll be on my own, and that’s my goal with this.
          </p>
        </TextReveal>

        <TextReveal delay={100} duration={1000}>
          <h2 class="section-title chuj-font">
            work
          </h2>
        </TextReveal>

        <TextReveal delay={200} duration={1000}>
          <p>
            <a class="hover-box" href="https://github.com/takyon303/sonora">sonora</a> — my main focus right now <br />
            <a class="hover-box" href="https://github.com/takyon303/axp.os">axp.os port for g531f</a> — on hold
          </p>
        </TextReveal>

        <TextReveal delay={100} duration={1000}>
          <h2 class="section-title chuj-font">
            contact
          </h2>
        </TextReveal>

        <TextReveal delay={200} duration={1000}>
          <div class="contact-links">
            <a class="hover-box" href="https://discord.com/users/1558457158138462255">discord</a>
            <a class="hover-box" href="https://t.me/takyon303">telegram</a>
            <a class="hover-box" href="https://github.com/takyon303">github</a>
            <a class="hover-box" href="https://www.last.fm/user/takyon303">last.fm</a>
          </div>
        </TextReveal>

        <footer class="credit">
          <a
            class="hover-box"
            href="https://www.github.com/cfels"
            style="opacity: 0.5; color: #acddff !important;"
          >
            made by moxiu
          </a>
        </footer>
      </main>
    </div>
  </body>
</html>
